{%- comment -%}
  Renders a luxury product card matching Homework Living (Prestige 10.1.0) aesthetic
  Accepts:
  - card_product: {Object} Product Liquid object
  - show_secondary_image: {Boolean}
  - section_id: {String}
{%- endcomment -%}

{%- if card_product and card_product != empty -%}
  <div class="product-card group relative flex flex-col justify-between bg-white text-left">
    <!-- Image Viewport (Aspect Square 1:1) -->
    <div class="product-card__media relative aspect-square w-full overflow-hidden bg-neutral-100">
      <a href="{{ card_product.url }}" class="block w-full h-full">
        {%- if card_product.featured_media -%}
          <img
            src="{{ card_product.featured_media | image_url: width: 800 }}"
            alt="{{ card_product.featured_media.alt | escape }}"
            loading="lazy"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 {% if card_product.media[1] != nil and show_secondary_image %}group-hover:opacity-0{% endif %}"
          >
          {%- if card_product.media[1] != nil and show_secondary_image -%}
            <img
              src="{{ card_product.media[1] | image_url: width: 800 }}"
              alt="{{ card_product.media[1].alt | escape }}"
              loading="lazy"
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
              class="w-full h-full object-cover object-center absolute inset-0 opacity-0 group-hover:opacity-100 transition-all duration-700 ease-out group-hover:scale-105"
            >
          {%- endif -%}
        {%- else -%}
          <div class="placeholder-image w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </a>

      <!-- Quick Add / View button overlay (Desktop) -->
      <div class="product-card__quick-add absolute inset-x-0 bottom-0 p-3 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out hidden md:block z-10">
        {%- if card_product.available -%}
          <button
            type="button"
            onclick="window.quickAddToCart('{{ card_product.selected_or_first_available_variant.id }}')"
            class="w-full bg-white/95 text-black text-[10px] tracking-[0.2em] uppercase py-3 hover:bg-black hover:text-white transition-colors duration-300 shadow-sm font-medium border border-neutral-100"
          >
            Quick Add
          </button>
        {%- else -%}
          <span class="w-full block text-center bg-neutral-200 text-neutral-600 text-[10px] tracking-[0.2em] uppercase py-3 font-medium">
            Made to Order
          </span>
        {%- endif -%}
      </div>
    </div>

    <!-- Product Info Section -->
    <div class="product-card__info flex flex-col pt-3.5 space-y-1.5">
      <div class="flex items-center justify-between">
        <span class="inline-block bg-[#f4f4f4] text-neutral-800 text-[9px] font-semibold tracking-wider uppercase px-2 py-0.5">
          Made to Order
        </span>
        {%- if card_product.tags contains 'Solid Teak' or card_product.tags contains 'Teak' -%}
          <span class="text-[9px] text-neutral-400 uppercase tracking-widest font-sans">
            Solid Teak
          </span>
        {%- endif -%}
      </div>

      <h3 class="product-card__title font-sans text-sm sm:text-base text-neutral-900 group-hover:text-neutral-600 transition-colors duration-300 leading-snug line-clamp-1 font-medium">
        <a href="{{ card_product.url }}">{{ card_product.title }}</a>
      </h3>

      <div class="pt-0.5">
        {% render 'price', product: card_product, price_class: 'text-sm font-semibold text-neutral-950' %}
      </div>
    </div>
  </div>
{%- endif -%}
