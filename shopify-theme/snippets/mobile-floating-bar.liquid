    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2.5 bg-neutral-950 text-white px-4 py-2.5 rounded-full shadow-2xl hover:bg-neutral-800 transition-all transform active:scale-95 border border-neutral-700/50"
