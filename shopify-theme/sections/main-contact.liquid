<section class="main-contact py-16 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Left Column: Contact Details & Info -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-3">
          <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans font-medium block">
            Factory & Atelier
          </span>
          <h1 class="font-serif text-3xl sm:text-4xl font-light tracking-wide text-neutral-900">
            Get In Touch
          </h1>
          <p class="text-neutral-500 font-sans text-xs sm:text-sm font-light leading-relaxed">
            Have questions about dimensions, timber finishes, shipping estimates, or a custom furniture blueprint? Reach out directly.
          </p>
        </div>

        <div class="space-y-6 text-neutral-700 font-sans text-xs sm:text-sm">
          <div class="space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold block">Workshop Address</span>
            <p class="font-light">ZOOSH Furniture Company<br>Pattambi, Palakkad District<br>Kerala, India - 679303</p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold block">Direct WhatsApp / Phone</span>
            <p class="font-light">
              <a href="https://wa.me/919567193992" class="hover:underline font-medium text-neutral-900">+91 9567193992</a>
            </p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold block">Email Inquiries</span>
            <p class="font-light">
              <a href="mailto:hello@zoosh.in" class="hover:underline font-medium text-neutral-900">hello@zoosh.in</a>
            </p>
          </div>

          <div class="space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold block">Hours of Operation</span>
            <p class="font-light">Monday – Saturday: 9:00 AM – 7:00 PM IST<br>Sunday: By Prior Appointment</p>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="https://wa.me/919567193992?text=Hello%20ZOOSH%20Team%2C%20I%20would%20like%20to%20enquire%20about%20your%20furniture."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-sans tracking-[0.2em] uppercase py-4 px-8 font-medium transition-colors"
          >
            {% render 'icon', icon: 'whatsapp' %}
            <span>Connect on WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Standard Shopify Contact Form -->
      <div class="lg:col-span-7 bg-neutral-50/50 border border-neutral-100 p-8 sm:p-12">
        <h2 class="font-serif text-xl sm:text-2xl font-light text-neutral-900 mb-6 tracking-wide">
          Send Us A Message
        </h2>

        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="p-4 bg-emerald-50 text-emerald-800 text-xs font-sans mb-6 border border-emerald-200">
              Thank you for reaching out! Our design team will review your message and contact you within 24 hours.
            </div>
          {%- elsif form.errors -%}
            <div class="p-4 bg-red-50 text-red-800 text-xs font-sans mb-6 border border-red-200">
              Please check the required form fields and try again.
            </div>
          {%- endif -%}

          <div class="space-y-4">
            <div>
              <label for="ContactFormName" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1.5 font-sans">
                Your Full Name
              </label>
              <input
                type="text"
                id="ContactFormName"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                class="w-full px-4 py-3 bg-white border border-neutral-200 text-xs font-sans focus:outline-none focus:border-black transition-colors"
                placeholder="e.g. Rahul Sharma"
                required
              >
            </div>

            <div>
              <label for="ContactFormEmail" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1.5 font-sans">
                Email Address
              </label>
              <input
                type="email"
                id="ContactFormEmail"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                class="w-full px-4 py-3 bg-white border border-neutral-200 text-xs font-sans focus:outline-none focus:border-black transition-colors"
                placeholder="e.g. rahul@example.com"
                required
              >
            </div>

            <div>
              <label for="ContactFormPhone" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1.5 font-sans">
                Phone / WhatsApp Number
              </label>
              <input
                type="tel"
                id="ContactFormPhone"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                class="w-full px-4 py-3 bg-white border border-neutral-200 text-xs font-sans focus:outline-none focus:border-black transition-colors"
                placeholder="e.g. +91 98765 43210"
              >
            </div>

            <div>
              <label for="ContactFormMessage" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1.5 font-sans">
                Project Details / Message
              </label>
              <textarea
                rows="5"
                id="ContactFormMessage"
                name="contact[body]"
                class="w-full px-4 py-3 bg-white border border-neutral-200 text-xs font-sans focus:outline-none focus:border-black transition-colors"
                placeholder="Tell us about your room space, required furniture pieces, custom dimensions, or delivery destination..."
                required
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-black hover:bg-neutral-900 text-white text-xs font-sans tracking-[0.25em] uppercase py-4 font-medium transition-colors shadow-sm"
            >
              Submit Inquiry
            </button>
          </div>
        {% endform %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
