<section class="main-collection py-10 sm:py-16 bg-white min-h-screen">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 space-y-3">
      <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans block">
        Bespoke Furniture Collection
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-light text-neutral-900 tracking-wide">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        <p class="font-sans text-xs sm:text-sm text-neutral-500 font-light leading-relaxed">
          {{ collection.description }}
        </p>
      {%- endif -%}
    </div>

    <!-- Product Count & Sort -->
    <div class="flex items-center justify-between border-b border-neutral-100 pb-4 mb-8 text-xs font-sans">
      <span class="text-neutral-500 font-light">
        <strong class="text-neutral-900 font-medium">{{ collection.products_count }}</strong> Creations
      </span>
      <div class="flex items-center space-x-2">
        <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-medium">Sort By:</span>
        <select
          id="SortBy"
          class="bg-transparent border border-neutral-200 text-xs py-1.5 px-3 focus:outline-none focus:border-black"
          onchange="location.href = '?sort_by=' + this.value"
        >
          <option value="manual">Featured</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="title-ascending">Alphabetically, A-Z</option>
          <option value="title-descending">Alphabetically, Z-A</option>
          <option value="created-descending">Date: New to Old</option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    {%- paginate collection.products by 12 -%}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product, show_secondary_image: true, section_id: section.id %}
        {%- else -%}
          <div class="col-span-full py-20 text-center space-y-3">
            <p class="text-neutral-500 font-sans text-sm font-light">No products currently in this collection.</p>
            <a href="{{ routes.all_products_collection_url }}" class="inline-block text-xs font-sans tracking-widest uppercase font-semibold border-b border-black pb-0.5">
              Browse All Furniture
            </a>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pt-16 flex items-center justify-center space-x-2 font-sans text-xs">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
