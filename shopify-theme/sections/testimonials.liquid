<section class="testimonials py-16 sm:py-24 bg-white border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-sans block mb-2 font-medium">
        {{ section.settings.subheading | default: 'Client Stories' }}
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-neutral-900 font-normal">
        {{ section.settings.heading | default: 'Spaces Transformed' }}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {%- for block in section.blocks -%}
        <div class="bg-[#faf9f6] p-7 sm:p-8 flex flex-col justify-between border border-neutral-150" {{ block.shopify_attributes }}>
          <div>
            <!-- Star Rating -->
            <div class="flex items-center gap-1 text-neutral-900 mb-4">
              {%- for i in (1..5) -%}
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {%- endfor -%}
            </div>

            <p class="font-serif text-base sm:text-lg text-neutral-800 italic leading-relaxed mb-6">
              "{{ block.settings.quote }}"
            </p>
          </div>

          <div class="pt-4 border-t border-neutral-200/60 flex items-center justify-between">
            <div>
              <h4 class="text-xs font-sans tracking-wider uppercase font-semibold text-neutral-900">
                {{ block.settings.author }}
              </h4>
              <span class="text-[11px] text-neutral-400 font-sans block">
                {{ block.settings.location }}
              </span>
            </div>
            {%- if block.settings.item_bought != blank -%}
              <span class="text-[10px] tracking-wider uppercase bg-white border border-neutral-200 px-2 py-0.5 text-neutral-600 font-medium">
                {{ block.settings.item_bought }}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Client Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spaces Transformed"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The solid teak dining table from ZOOSH exceeded our expectations. The joinery and hand-finish are truly world-class, delivered seamlessly to Bangalore."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Arun & Meera"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Bangalore Villa"
        },
        {
          "type": "text",
          "id": "item_bought",
          "label": "Product Commissioned",
          "default": "Bespoke Dining Table"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The solid teak dining table from ZOOSH exceeded our expectations. The joinery and hand-finish are truly world-class, delivered seamlessly to Bangalore.",
            "author": "Arun & Meera",
            "location": "Bangalore",
            "item_bought": "8-Seater Teak Dining"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered custom bedroom cots with woven cane headboards. The Pattambi factory craftsmanship is stunning—durable, monolithic, and timeless.",
            "author": "Dr. Farhan K.",
            "location": "Kochi",
            "item_bought": "Plinth King Cot"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Architectural furniture made with real seasoned hardwood. No MDF or shortcuts. Their WhatsApp consultation team guided us through custom dimensions perfectly.",
            "author": "Sneha Sen",
            "location": "Mumbai",
            "item_bought": "Modular Sectional Sofa"
          }
        }
      ]
    }
  ]
}
{% endschema %}
