<section class="cta-banner relative py-20 sm:py-28 flex items-center justify-center bg-neutral-950 overflow-hidden text-white">
  <!-- Background Image Overlay -->
  <div class="absolute inset-0 z-0">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        class="w-full h-full object-cover opacity-25"
      >
    {%- else -%}
      <div class="w-full h-full bg-neutral-900 opacity-40"></div>
    {%- endif -%}
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 md:px-12 text-center space-y-6">
    {%- if section.settings.subheading != blank -%}
      <span class="text-[10px] tracking-[0.35em] uppercase text-neutral-300 font-sans font-medium block">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}

    <h2 class="font-serif text-3xl sm:text-5xl font-light tracking-wide max-w-2xl mx-auto leading-tight">
      {{ section.settings.heading | default: 'Have a blueprint or bespoke design in mind?' }}
    </h2>

    {%- if section.settings.text != blank -%}
      <p class="text-neutral-300 font-sans text-xs sm:text-sm md:text-base font-light leading-relaxed max-w-xl mx-auto">
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-2">
      {%- if section.settings.primary_button_link != blank -%}
        <a
          href="{{ section.settings.primary_button_link }}"
          class="inline-flex items-center justify-center bg-white text-black hover:bg-neutral-100 text-xs font-sans tracking-[0.2em] uppercase py-4 px-8 font-medium transition-all duration-300 min-w-[200px]"
        >
          {{ section.settings.primary_button_text | default: 'Request A Quote' }}
        </a>
      {%- endif -%}

      <a
        href="https://wa.me/{{ settings.whatsapp_phone | replace: '+', '' | replace: ' ', '' }}?text=Hello%20ZOOSH%20Team%2C%20I%20have%20a%20custom%20interior%20furniture%20project%20and%20would%20like%20to%20consult%20with%20your%20designers."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center space-x-2 border border-white text-white text-xs font-sans tracking-[0.2em] uppercase py-4 px-8 hover:bg-white hover:text-black transition-colors font-medium min-w-[200px]"
      >
        {% render 'icon', icon: 'whatsapp' %}
        <span>WhatsApp Concierge</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Custom Commissions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Have a blueprint or bespoke design in mind?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Share your room dimensions, floor plans, or moodboards. Our craftsmen and designers will engineer furniture tailored specifically for your space."
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Label",
      "default": "Request A Quote"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
