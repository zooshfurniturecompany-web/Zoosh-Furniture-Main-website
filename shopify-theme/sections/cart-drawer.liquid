<div id="cart-drawer-container" class="cart-drawer-wrapper fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0">
  <!-- Overlay Backdrop -->
  <div class="cart-drawer-overlay absolute inset-0 bg-black/60 backdrop-blur-xs cursor-pointer" onclick="window.toggleCartDrawer()"></div>

  <!-- Slide-out Drawer Panel -->
  <div class="cart-drawer-panel absolute top-0 right-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out z-10">
    
    <!-- Drawer Header -->
    <div class="p-6 border-b border-neutral-100 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <h3 class="font-serif text-xl font-normal text-neutral-900 uppercase tracking-wider">Shopping Bag</h3>
        <span class="text-xs font-mono text-neutral-400">({{ cart.item_count }})</span>
      </div>
      <button type="button" class="p-2 text-neutral-500 hover:text-black transition-colors" onclick="window.toggleCartDrawer()" aria-label="Close cart">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    <!-- Free Shipping Progress -->
    <div class="px-6 py-3 bg-neutral-50 border-b border-neutral-100 text-xs font-sans text-neutral-600">
      <p class="mb-1.5 font-light">Free Factory Crating & Pan-India Transport on orders above ₹50,000</p>
      <div class="w-full bg-neutral-200 h-1 rounded-full overflow-hidden">
        <div class="bg-black h-full" style="width: {% if cart.total_price >= 5000000 %}100%{% else %}{{ cart.total_price | times: 100 | divided_by: 5000000 }}%{% endif %};"></div>
      </div>
    </div>

    <!-- Drawer Line Items List -->
    <div class="flex-1 overflow-y-auto p-6 space-y-6" id="cart-drawer-items">
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <div class="flex gap-4 pb-6 border-b border-neutral-100 items-start">
            <div class="w-20 h-20 aspect-square bg-neutral-100 flex-shrink-0 overflow-hidden relative border border-neutral-100">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
              {%- endif -%}
            </div>
            <div class="flex-1 space-y-1">
              <h4 class="font-sans text-xs font-medium text-neutral-900 line-clamp-1">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </h4>
              {%- unless item.product.has_only_default_variant -%}
                <p class="text-[10px] text-neutral-400 font-sans tracking-wide uppercase">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="pt-1 flex items-center justify-between">
                <span class="text-xs font-semibold text-neutral-950 font-sans tabular-nums">{{ item.final_line_price | money }}</span>
                <button type="button" onclick="window.updateCartQuantity('{{ item.key }}', 0)" class="text-[10px] text-neutral-400 hover:text-red-500 uppercase tracking-wider underline">
                  Remove
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="py-20 text-center space-y-3">
          <p class="font-sans text-sm text-neutral-400 font-light">Your bag is currently empty.</p>
          <a href="/collections/all" class="inline-block text-xs font-sans tracking-widest uppercase font-semibold border-b border-black pb-0.5">
            Explore Furniture
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Drawer Footer -->
    <div class="p-6 border-t border-neutral-100 bg-white space-y-4">
      <div class="flex items-center justify-between font-sans text-sm">
        <span class="text-neutral-500 font-light uppercase tracking-wider text-xs">Subtotal</span>
        <span class="font-semibold text-neutral-950 text-base tabular-nums">{{ cart.total_price | money }}</span>
      </div>
      <p class="text-[10px] text-neutral-400 font-sans font-light">Taxes calculated at checkout. Custom dimensions confirmed post-order.</p>

      <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form" class="space-y-2.5">
        <button
          type="submit"
          name="checkout"
          class="w-full bg-black hover:bg-neutral-900 text-white text-xs font-sans tracking-[0.25em] uppercase py-4 font-medium transition-colors shadow-sm"
        >
          Checkout &bull; {{ cart.total_price | money }}
        </button>

        <a
          href="https://wa.me/{{ settings.whatsapp_phone | replace: '+', '' | replace: ' ', '' }}?text=Hello%20ZOOSH%2C%20I%20would%20like%20to%20place%20an%20order%20for%20items%20in%20my%20bag%20(Total%3A%20{{ cart.total_price | money | url_encode }})."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-sans tracking-[0.25em] uppercase py-3.5 font-medium transition-colors"
        >
          {% render 'icon', icon: 'whatsapp' %}
          <span>Order via WhatsApp</span>
        </a>
      </form>
    </div>

  </div>
</div>
