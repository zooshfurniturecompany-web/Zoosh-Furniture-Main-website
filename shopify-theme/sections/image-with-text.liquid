<section class="image-with-text py-16 sm:py-24 bg-neutral-50/60 border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Image Column -->
      <div class="lg:col-span-6 relative aspect-square sm:aspect-[4/3] lg:aspect-square overflow-hidden bg-neutral-200 shadow-md">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            class="w-full h-full object-cover object-center"
          >
        {%- else -%}
          <div class="w-full h-full bg-neutral-200 flex items-center justify-center text-neutral-400">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <!-- Text Story Column -->
      <div class="lg:col-span-6 space-y-6">
        {%- if section.settings.subheading != blank -%}
          <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans block">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-wide text-neutral-900 leading-tight">
          {{ section.settings.heading | default: 'Rooted In Raw Timber, Mastered By Hand' }}
        </h2>

        <div class="space-y-4 text-neutral-600 font-sans text-xs sm:text-sm font-light leading-relaxed">
          {{ section.settings.text }}
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          {%- if section.settings.button_link != blank -%}
            <a
              href="{{ section.settings.button_link }}"
              class="inline-flex items-center justify-center bg-black text-white hover:bg-neutral-800 text-xs font-sans tracking-[0.25em] uppercase px-8 py-4 font-medium transition-colors shadow-sm"
            >
              {{ section.settings.button_text | default: 'Our Story & Philosophy' }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_link != blank -%}
            <a
              href="{{ section.settings.secondary_link }}"
              class="inline-flex items-center justify-center border border-neutral-300 text-neutral-900 hover:border-black text-xs font-sans tracking-[0.25em] uppercase px-8 py-4 font-medium transition-colors"
            >
              {{ section.settings.secondary_text | default: 'Factory Blueprint Visit' }}
            </a>
          {%- endif -%}
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Artisanal Journey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seasoned Hardwoods Crafted in Pattambi"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Narrative Text",
      "default": "<p>Every ZOOSH creation is born inside our dedicated Kerala factory. We season solid timber, carve mortise-and-tenon joints, hand-plane organic chamfers, and hand-tailor commercial grade linens to elevate your interior living architecture.</p>"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Label",
      "default": "Bespoke Consultations"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
