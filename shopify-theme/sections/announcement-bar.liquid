{%- if section.settings.show_announcement -%}
  <div class="announcement-bar bg-black text-white text-[11px] font-sans tracking-[0.2em] uppercase py-2.5 px-4 text-center border-b border-neutral-800">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-4">
      <span>{{ section.settings.announcement_text }}</span>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="underline hover:opacity-80 transition-opacity">
          {{ section.settings.link_text | default: 'Explore Now' }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Bespoke Solid Wood Furniture • Handcrafted in Pattambi Factory • Pan-India Delivery"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (Optional)"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Learn More"
    }
  ]
}
{% endschema %}
