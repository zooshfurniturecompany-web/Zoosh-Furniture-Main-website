<section class="main-custom py-16 sm:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6 md:px-12 space-y-12">
    
    <div class="text-center space-y-3">
      <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans font-medium block">
        Bespoke Workshop Commission
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-light tracking-wide text-neutral-900">
        Custom Furniture Tailored To Your Blueprints
      </h1>
      <p class="text-neutral-500 font-sans text-xs sm:text-sm font-light max-w-xl mx-auto leading-relaxed">
        Whether you have architectural room dimensions, a 3D sketch, or specific wood preferences, our Pattambi team will manufacture the piece to your exact metrics.
      </p>
    </div>

    <!-- 6-Step Made to Order Process -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 pt-4">
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">01</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Share Dimensions</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Send floor plans, photos, or desired measurements of your space.</p>
      </div>
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">02</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Timber & Finish</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Choose between seasoned Kerala Teak, Ash wood, or Mahogany with custom stains.</p>
      </div>
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">03</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Upholstery & Cane</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Select textured bouclé, linen-cotton blends, or handwoven rattan cane.</p>
      </div>
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">04</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Factory Crafting</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Built by master joiners in Pattambi with reinforced mortise-and-tenon construction.</p>
      </div>
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">05</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Quality Inspection</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Rigorous verification of stability, sanding lines, and structural alignment.</p>
      </div>
      <div class="p-6 border border-neutral-100 bg-neutral-50/30 space-y-2">
        <span class="font-serif text-2xl text-neutral-300 font-light block">06</span>
        <h3 class="font-serif text-sm text-neutral-900 font-medium">Pan-India Delivery</h3>
        <p class="text-neutral-500 text-xs font-sans font-light">Secure crated freight shipped directly to your residence across India.</p>
      </div>
    </div>

    <!-- Direct WhatsApp Commission Trigger -->
    <div class="p-8 sm:p-12 border border-neutral-900 bg-neutral-950 text-white text-center space-y-6">
      <h3 class="font-serif text-2xl sm:text-3xl font-light tracking-wide">
        Ready to start your bespoke piece?
      </h3>
      <p class="text-neutral-300 font-sans text-xs sm:text-sm font-light max-w-md mx-auto">
        Connect directly with our workshop design team on WhatsApp. Share drawings, photos, or rough dimensions for immediate assistance.
      </p>
      <a
        href="https://wa.me/{{ settings.whatsapp_phone | replace: '+', '' | replace: ' ', '' }}?text=Hello%20ZOOSH%20Team%2C%20I%20would%20like%20to%20commission%20a%20custom%20furniture%20piece%20with%20bespoke%20dimensions."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-white text-black hover:bg-neutral-100 text-xs font-sans tracking-[0.2em] uppercase py-4 px-8 font-medium transition-colors"
      >
        {% render 'icon', icon: 'whatsapp' %}
        <span>Chat with Workshop Team (+91 9567193992)</span>
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Custom Furniture",
  "settings": []
}
{% endschema %}
