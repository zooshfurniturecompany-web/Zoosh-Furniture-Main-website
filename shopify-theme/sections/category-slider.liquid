<section class="category-slider py-16 sm:py-24 bg-white border-b border-neutral-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Section Header with Arrows -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 sm:mb-12 gap-4">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans block mb-2 font-medium">
            {{ section.settings.subheading }}
          </span>
        {%- endif -%}
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light tracking-wide text-neutral-900">
          {{ section.settings.heading | default: 'Curated Living Spaces' }}
        </h2>
      </div>

      <!-- Navigation Arrows -->
      <div class="hidden sm:flex items-center space-x-3">
        <button
          type="button"
          onclick="window.scrollCategorySlider(-340)"
          class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white hover:border-black transition-colors"
          aria-label="Previous space"
        >
          &larr;
        </button>
        <button
          type="button"
          onclick="window.scrollCategorySlider(340)"
          class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-800 hover:bg-black hover:text-white hover:border-black transition-colors"
          aria-label="Next space"
        >
          &rarr;
        </button>
      </div>
    </div>

    <!-- Category Image Cards Horizontal Slider -->
    <div
      id="category-slider-track"
      class="flex gap-4 sm:gap-6 overflow-x-auto pb-4 scroll-smooth no-scrollbar"
      style="-webkit-overflow-scrolling: touch; scroll-snap-type: x mandatory;"
    >
      {%- for block in section.blocks -%}
        {%- assign fallback_img = 'https://zoosh.in/images/catalog/page_14_img_00.webp' -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign fallback_img = 'https://zoosh.in/images/catalog/page_14_img_00.webp' -%}
          {%- when 2 -%}{%- assign fallback_img = 'https://zoosh.in/images/catalog/page_21_img_00.webp' -%}
          {%- when 3 -%}{%- assign fallback_img = 'https://zoosh.in/images/catalog/page_22_img_00.webp' -%}
          {%- when 4 -%}{%- assign fallback_img = 'https://zoosh.in/images/catalog/page_15_img_00.webp' -%}
          {%- when 5 -%}{%- assign fallback_img = 'https://zoosh.in/images/catalog/page_27_img_00.webp' -%}
        {%- endcase -%}

        <div
          class="flex-shrink-0 w-[260px] sm:w-[320px] group cursor-pointer"
          style="scroll-snap-align: start;"
          {{ block.shopify_attributes }}
        >
          <a href="{{ block.settings.link }}" class="block">
            <!-- Card Image -->
            <div class="relative aspect-square overflow-hidden bg-neutral-100 mb-4 border border-neutral-100">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                >
              {%- else -%}
                <img
                  src="{{ fallback_img }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                >
              {%- endif -%}

              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-70 group-hover:opacity-50 transition-opacity"></div>
              
              <!-- Floating Card Title on Image -->
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <h3 class="font-serif text-lg sm:text-xl font-medium tracking-wide">
                  {{ block.settings.title }}
                </h3>
                <span class="text-[10px] tracking-[0.2em] uppercase text-white/80 font-sans mt-0.5 block">
                  {{ block.settings.subtitle | default: 'Explore Space →' }}
                </span>
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Category Card Slider",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop By Room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Living Spaces"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Space Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Living Space"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Badge",
          "default": "Modular Sofas, Lounges & Coffee Tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Card Slider",
      "blocks": [
        { "type": "category_card", "settings": { "title": "Living Space", "subtitle": "Modular Sofas, Lounges & Coffee Tables", "link": "/collections/living" } },
        { "type": "category_card", "settings": { "title": "Dining Room", "subtitle": "Solid Hardwood Tables & Ergonomic Chairs", "link": "/collections/dining" } },
        { "type": "category_card", "settings": { "title": "Bedroom Sanctuary", "subtitle": "Plinth Bed Cots & Floating Nightstands", "link": "/collections/bedroom" } },
        { "type": "category_card", "settings": { "title": "Accent Seating", "subtitle": "Sculptural Bouclé & Cane Armchairs", "link": "/collections/chairs" } },
        { "type": "category_card", "settings": { "title": "Entryway & Credenzas", "subtitle": "Monolithic Consoles & Entry Benches", "link": "/collections/entryway" } }
      ]
    }
  ]
}
{% endschema %}
