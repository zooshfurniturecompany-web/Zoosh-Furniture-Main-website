<section class="slideshow-hero relative w-full overflow-hidden bg-neutral-900 text-white min-h-[75vh] sm:min-h-[85vh] flex items-center">
  <!-- Hero Background Image -->
  <div class="absolute inset-0 z-0">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        class="w-full h-full object-cover object-center"
        loading="eager"
      >
    {%- else -%}
      <img
        src="https://zoosh.in/images/hero-bg.jpg"
        alt="ZOOSH Handcrafted Furniture Background"
        class="w-full h-full object-cover object-center"
        loading="eager"
      >
    {%- endif -%}
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-24 sm:py-32 w-full">
    <div class="max-w-2xl space-y-6">
      
      {%- if section.settings.subheading != blank -%}
        <div class="inline-block">
          <span class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-300 font-medium px-3 py-1 bg-white/10 backdrop-blur-xs border border-white/20">
            {{ section.settings.subheading }}
          </span>
        </div>
      {%- endif -%}

      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-light tracking-wide text-white leading-[1.12]">
        {{ section.settings.heading }}
      </h1>

      {%- if section.settings.text != blank -%}
        <p class="font-sans text-xs sm:text-sm md:text-base text-neutral-200 font-light leading-relaxed max-w-xl">
          {{ section.settings.text }}
        </p>
      {%- endif -%}

      <div class="pt-4 flex flex-wrap items-center gap-4">
        {%- if section.settings.button_link != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="inline-flex items-center justify-center bg-white text-black hover:bg-neutral-100 text-xs font-sans tracking-[0.2em] uppercase px-8 py-4 font-medium transition-all shadow-lg min-w-[180px]"
          >
            {{ section.settings.button_text | default: 'Explore Collections' }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_link != blank -%}
          <a
            href="{{ section.settings.secondary_button_link }}"
            class="inline-flex items-center justify-center border border-white text-white hover:bg-white hover:text-black text-xs font-sans tracking-[0.2em] uppercase px-8 py-4 font-medium transition-all min-w-[180px]"
          >
            {{ section.settings.secondary_button_text | default: 'Custom Commission' }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slideshow",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bespoke Hardwood Architecture • Kerala Factory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Every Home Deserves Furniture Built Specifically For It."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Description",
      "default": "Crafted in solid Teak, Ash & Mahogany woods, natural woven cane, and premium tailored fabrics. Custom manufactured in our Pattambi workshop."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Label",
      "default": "Custom Commission"
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow"
    }
  ]
}
{% endschema %}
