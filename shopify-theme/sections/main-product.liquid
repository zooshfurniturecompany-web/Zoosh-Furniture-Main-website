<section class="main-product py-10 sm:py-16 bg-white min-h-screen">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 text-[10px] tracking-widest uppercase text-neutral-400 mb-8 font-sans font-medium">
      <a href="{{ routes.root_url }}" class="hover:text-black transition-colors">Home</a>
      <span>/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}" class="hover:text-black transition-colors">{{ collection.title }}</a>
        <span>/</span>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="hover:text-black transition-colors">Furniture</a>
        <span>/</span>
      {%- endif -%}
      <span class="text-neutral-900 truncate">{{ product.title }}</span>
    </div>

    <!-- Main Product Grid (Homework Living Layout) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Image Gallery Stack / Thumbnails -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Main Featured Image -->
        <div class="product-main-image relative aspect-square w-full bg-neutral-100 overflow-hidden border border-neutral-100">
          {%- if product.featured_media -%}
            <img
              id="ProductMainImage"
              src="{{ product.featured_media | image_url: width: 1400 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              class="w-full h-full object-cover object-center"
              loading="eager"
            >
          {%- else -%}
            <img
              id="ProductMainImage"
              src="https://zoosh.in/images/products/sf001-2.jpg"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover object-center"
              loading="eager"
            >
          {%- endif -%}
        </div>

        <!-- Thumbnail Grid if multiple images -->
        {%- if product.media.size > 1 -%}
          <div class="grid grid-cols-4 sm:grid-cols-5 gap-3 pt-1">
            {%- for media in product.media -%}
              <div
                class="aspect-square bg-neutral-100 cursor-pointer overflow-hidden border {% if forloop.first %}border-black{% else %}border-neutral-200{% endif %} hover:border-black transition-colors"
                onclick="document.getElementById('ProductMainImage').src='{{ media | image_url: width: 1400 }}'; document.querySelectorAll('.product-thumb').forEach(el => el.classList.remove('border-black')); this.classList.add('border-black');"
              >
                <img src="{{ media | image_url: width: 250 }}" alt="{{ media.alt | default: product.title | escape }}" class="w-full h-full object-cover">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Sticky Product Form & Specifications (Homework Living Style) -->
      <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-28 bg-white">
        
        <!-- Vendor & Title -->
        <div class="space-y-2">
          <span class="text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-sans font-medium block">
            {{ product.vendor | default: 'ZOOSH' }}
          </span>

          <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-neutral-950 tracking-wide leading-tight">
            {{ product.title }}
          </h1>

          {%- if product.selected_or_first_available_variant.sku != blank -%}
            <p class="text-[10px] tracking-wider text-neutral-400 font-mono">
              SKU: {{ product.selected_or_first_available_variant.sku }}
            </p>
          {%- endif -%}
        </div>

        <!-- Price Block (Clean Homework Living Style) -->
        <div class="py-3 border-t border-b border-neutral-100 space-y-1">
          <div class="flex items-baseline gap-3">
            <span id="ProductPrice" class="font-sans text-2xl sm:text-3xl font-bold text-neutral-950 tracking-tight tabular-nums">
              {{ product.selected_or_first_available_variant.price | money }}
            </span>
            {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
              <span id="ComparePrice" class="font-sans text-sm sm:text-base text-neutral-400 line-through tabular-nums">
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
            {%- endif -%}
          </div>
          <span class="text-[11px] text-neutral-500 font-sans font-light tracking-wide block">
            Tax included. Shipping calculated at checkout.
          </span>
        </div>

        <!-- Product Form: Variants, Quantity, Add to Cart -->
        {% form 'product', product, id: 'product-form', class: 'space-y-5' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="SelectedVariantId">

          <!-- Variant Options (Pill selectors) -->
          {%- unless product.has_only_default_variant -%}
            <div class="space-y-4">
              {%- for option in product.options_with_values -%}
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-xs font-sans">
                    <span class="font-semibold uppercase tracking-wider text-neutral-900">{{ option.name }}</span>
                    <span class="text-neutral-500 font-light" id="OptionLabel-{{ forloop.index }}">{{ option.selected_value }}</span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {%- for value in option.values -%}
                      <label class="cursor-pointer">
                        <input
                          type="radio"
                          name="{{ option.name }}"
                          value="{{ value }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          class="sr-only peer"
                          onchange="document.getElementById('OptionLabel-{{ forloop.parentloop.index }}').textContent = '{{ value }}';"
                        >
                        <span class="inline-block px-4 py-2.5 text-xs font-sans tracking-wide border border-neutral-200 peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-all">
                          {{ value }}
                        </span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity Selector -->
          <div class="space-y-2 pt-1">
            <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-900 font-sans">
              Quantity
            </label>
            <div class="inline-flex items-center border border-neutral-200 bg-white">
              <button
                type="button"
                onclick="const q = document.getElementById('Quantity'); if(parseInt(q.value) > 1) q.value = parseInt(q.value) - 1;"
                class="px-4 py-2.5 text-neutral-600 hover:text-black font-mono text-sm"
                aria-label="Decrease quantity"
              >
                &minus;
              </button>
              <input
                type="number"
                id="Quantity"
                name="quantity"
                value="1"
                min="1"
                class="w-12 text-center text-xs font-sans font-medium focus:outline-none border-none p-0"
              >
              <button
                type="button"
                onclick="const q = document.getElementById('Quantity'); q.value = parseInt(q.value) + 1;"
                class="px-4 py-2.5 text-neutral-600 hover:text-black font-mono text-sm"
                aria-label="Increase quantity"
              >
                &#43;
              </button>
            </div>
          </div>

          <!-- CTAs: Add to Cart & Buy Now / WhatsApp -->
          <div class="space-y-3 pt-2">
            <button
              type="submit"
              name="add"
              class="w-full bg-black hover:bg-neutral-900 text-white text-xs font-sans tracking-[0.25em] uppercase py-4.5 font-medium transition-all duration-200 shadow-sm text-center"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}
                Add to Cart
              {%- else -%}
                Made to Order
              {%- endif -%}
            </button>

            <a
              href="https://wa.me/{{ settings.whatsapp_phone | replace: '+', '' | replace: ' ', '' }}?text=Hello%20ZOOSH%2C%20I%20am%20interested%20in%20'{{ product.title | url_encode }}'%20({{ product.selected_or_first_available_variant.price | money | url_encode }}).%20Please%20share%20custom%20finish%20options."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 border border-neutral-900 hover:bg-neutral-900 hover:text-white text-neutral-900 text-xs font-sans tracking-[0.25em] uppercase py-4 font-medium transition-all duration-200"
            >
              {% render 'icon', icon: 'whatsapp' %}
              <span>Order via WhatsApp</span>
            </a>
          </div>
        {% endform %}

        <!-- Pan-India Shipping Estimation Box (Homework Living Style) -->
        <div class="p-4 bg-neutral-50 border border-neutral-100 flex items-center gap-3 text-xs font-sans text-neutral-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-900 flex-shrink-0">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
            <path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
            <circle cx="17" cy="18" r="2"/>
            <circle cx="7" cy="18" r="2"/>
          </svg>
          <p class="font-light leading-relaxed">
            <strong class="font-medium text-neutral-900">White-Glove Insured Delivery:</strong> Estimated dispatch within 10 - 15 business days across India.
          </p>
        </div>

        <!-- Product Overview & Specifications (OPEN / UNCOLLAPSED - NO ACCORDIONS) -->
        <div class="pt-6 border-t border-neutral-100 space-y-6 font-sans text-xs text-neutral-700">
          
          <!-- Open Product Description -->
          <div class="space-y-2">
            <h3 class="font-serif text-sm uppercase tracking-wider text-neutral-900 font-semibold">
              Product Overview
            </h3>
            <div class="text-neutral-600 font-light leading-relaxed space-y-2">
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                <p>Handcrafted in treated solid hardwood with a smooth melamine matte finish. Built specifically to order with reinforced mortise-and-tenon structural joints.</p>
              {%- endif -%}
            </div>
          </div>

          <!-- Open Technical Specifications List -->
          <div class="space-y-2.5 pt-2 border-t border-neutral-100">
            <h3 class="font-serif text-sm uppercase tracking-wider text-neutral-900 font-semibold">
              Specifications
            </h3>
            <div class="space-y-2 text-xs">
              <div class="flex justify-between py-1 border-b border-neutral-100">
                <span class="text-neutral-400 font-light">Timber Material</span>
                <span class="text-neutral-900 font-medium">Kiln-Dried Solid Hardwood</span>
              </div>
              <div class="flex justify-between py-1 border-b border-neutral-100">
                <span class="text-neutral-400 font-light">Finish / Sealer</span>
                <span class="text-neutral-900 font-medium">Melamine Hand-Rubbed Polish</span>
              </div>
              <div class="flex justify-between py-1 border-b border-neutral-100">
                <span class="text-neutral-400 font-light">Custom Sizing</span>
                <span class="text-neutral-900 font-medium">Available Upon Request</span>
              </div>
              <div class="flex justify-between py-1 border-b border-neutral-100">
                <span class="text-neutral-400 font-light">Atelier Origin</span>
                <span class="text-neutral-900 font-medium">Pattambi Factory, Kerala</span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-neutral-400 font-light">Warranty</span>
                <span class="text-neutral-900 font-medium">5-Year Structural Frame Warranty</span>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- Related Products ("You May Also Like") Section -->
    <div class="mt-20 sm:mt-28 pt-12 border-t border-neutral-100">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-sans block font-medium">
          Curated Recommendations
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-wide text-neutral-900">
          You May Also Like
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {%- assign current_handle = product.handle -%}
        {%- assign recommended_count = 0 -%}
        {%- if collection != blank and collection.products.size > 1 -%}
          {%- for rec in collection.products -%}
            {%- unless rec.handle == current_handle -%}
              {% render 'product-card', card_product: rec, show_secondary_image: true, section_id: 'rec-' | append: rec.id %}
              {%- assign recommended_count = recommended_count | plus: 1 -%}
              {%- if recommended_count == 4 -%}{%- break -%}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback Real Zoosh Products with Clean Pricing -->
          {%- assign rec_samples = 'Aura Sectional Sofa|1,34,500|Solid Ash Wood|https://zoosh.in/images/products/sf002-main.jpg;;;Kanso Sofa|75,990|Solid Mahogany|https://zoosh.in/images/products/sf003-1.jpg;;;Kyoto Sectional Sofa|1,36,700|Solid Ash Wood|https://zoosh.in/images/products/sf004-1.jpg;;;Haven Sectional Sofa|53,200|Solid Teak Wood|https://zoosh.in/images/products/sf005-1.jpg' | split: ';;;' -%}
          {%- for p_data in rec_samples -%}
            {%- assign p_parts = p_data | split: '|' -%}
            {%- assign p_name = p_parts[0] | strip -%}
            {%- assign p_price = p_parts[1] | strip -%}
            {%- assign p_mat = p_parts[2] | strip -%}
            {%- assign p_img = p_parts[3] | strip -%}

            <div class="product-card group relative flex flex-col justify-between bg-white text-left">
              <div class="product-card__media relative aspect-square w-full overflow-hidden bg-neutral-100 border border-neutral-100">
                <img
                  src="{{ p_img }}"
                  alt="{{ p_name }}"
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                >
              </div>
              <div class="product-card__info flex flex-col pt-3.5 space-y-1">
                <span class="inline-block bg-[#f4f4f4] text-neutral-800 text-[9px] font-semibold tracking-wider uppercase px-2 py-0.5 w-fit">
                  Made to Order
                </span>
                <h3 class="product-card__title font-sans text-sm sm:text-base text-neutral-900 font-medium leading-snug">
                  {{ p_name }}
                </h3>
                <div class="pt-0.5">
                  <span class="font-sans text-sm font-semibold text-neutral-950 tabular-nums block">
                    ₹{{ p_price }}
                  </span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- D'tale Modern Mobile Sticky Buy Bar -->
    <div id="mobile-sticky-pdp-bar" class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-md border-t border-neutral-200/90 p-3 z-40 md:hidden flex items-center justify-between gap-3 shadow-2xl">
      <div class="flex items-center gap-2.5 overflow-hidden flex-1">
        <div class="w-10 h-10 bg-neutral-100 flex-shrink-0 overflow-hidden rounded-xs border border-neutral-200">
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">
          {%- endif -%}
        </div>
        <div class="truncate pr-1">
          <p class="text-[11px] font-sans font-medium text-neutral-900 truncate leading-tight">{{ product.title }}</p>
          <span class="text-xs font-bold text-neutral-950">{{ product.selected_or_first_available_variant.price | money }}</span>
        </div>
      </div>
      <button
        type="button"
        onclick="const f = document.getElementById('product-form'); if(f) f.requestSubmit();"
        class="flex-shrink-0 bg-black text-white text-[10.5px] font-sans font-semibold tracking-[0.14em] uppercase px-4 py-2.5 hover:bg-neutral-800 transition-colors shadow-sm"
      >
        {%- if product.available -%}Add to Cart{%- else -%}Custom Order{%- endif -%}
      </button>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
