<section class="category-pills py-6 sm:py-10 bg-white border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10">
    {%- if section.settings.heading != blank -%}
      <div class="mb-4 sm:mb-6 text-center sm:text-left">
        <h3 class="text-xs sm:text-sm font-sans tracking-[0.2em] uppercase font-semibold text-neutral-900">
          {{ section.settings.heading }}
        </h3>
      </div>
    {%- endif -%}

    <!-- Horizontal Swipeable Pills Track (D'tale Modern Style) -->
    <div class="flex items-center gap-4 sm:gap-8 overflow-x-auto no-scrollbar pb-2 px-1" style="-webkit-overflow-scrolling: touch;">
      {%- for block in section.blocks -%}
        {%- assign default_img = 'https://zoosh.in/images/products/sf002-main.jpg' -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign default_img = 'https://zoosh.in/images/products/sf002-main.jpg' -%}
          {%- when 2 -%}{%- assign default_img = 'https://zoosh.in/images/hero-dining.webp' -%}
          {%- when 3 -%}{%- assign default_img = 'https://zoosh.in/images/catalog/page_22_img_00.webp' -%}
          {%- when 4 -%}{%- assign default_img = 'https://zoosh.in/images/products/sf007-1.jpg' -%}
          {%- when 5 -%}{%- assign default_img = 'https://zoosh.in/images/catalog/page_27_img_00.webp' -%}
          {%- when 6 -%}{%- assign default_img = 'https://zoosh.in/images/catalog/page_15_img_00.webp' -%}
        {%- endcase -%}

        <a
          href="{{ block.settings.link }}"
          class="flex flex-col items-center flex-shrink-0 group text-center w-20 sm:w-24"
          {{ block.shopify_attributes }}
        >
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden bg-neutral-100 border border-neutral-200 p-1 group-hover:border-neutral-950 transition-all duration-300">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 200 }}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="80"
                height="80"
              >
            {%- else -%}
              <img
                src="{{ default_img }}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="80"
                height="80"
              >
            {%- endif -%}
          </div>
          <span class="mt-2 text-[10.5px] sm:text-xs font-sans tracking-wider uppercase text-neutral-800 font-medium group-hover:text-black line-clamp-1">
            {{ block.settings.title }}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Mobile Pills",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Explore By Category"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Living"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Mobile Pills",
      "blocks": [
        { "type": "category_item", "settings": { "title": "Living", "link": "/collections/living" } },
        { "type": "category_item", "settings": { "title": "Dining", "link": "/collections/dining" } },
        { "type": "category_item", "settings": { "title": "Bedroom", "link": "/collections/bedroom" } },
        { "type": "category_item", "settings": { "title": "Seating", "link": "/collections/chairs" } },
        { "type": "category_item", "settings": { "title": "Storage", "link": "/collections/entryway" } },
        { "type": "category_item", "settings": { "title": "Bespoke", "link": "/pages/custom-furniture" } }
      ]
    }
  ]
}
{% endschema %}
