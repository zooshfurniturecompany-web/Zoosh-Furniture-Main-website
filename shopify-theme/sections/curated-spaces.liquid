<section class="curated-spaces py-16 sm:py-24 bg-[#faf9f6] border-b border-neutral-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-14 gap-4">
      <div>
        <span class="text-[10px] tracking-[0.25em] uppercase text-neutral-500 font-sans block mb-2 font-medium">
          {{ section.settings.subheading | default: 'Shop By Room' }}
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-neutral-900 font-normal">
          {{ section.settings.heading | default: 'Curated Architectural Spaces' }}
        </h2>
      </div>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="text-xs font-sans tracking-[0.16em] uppercase font-semibold text-neutral-900 hover:text-neutral-600 underline underline-offset-4">
          {{ section.settings.link_text | default: 'View All Spaces' }} &rarr;
        </a>
      {%- endif -%}
    </div>

    <!-- Spaces Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {%- for block in section.blocks -%}
        {%- assign default_space_img = 'https://zoosh.in/images/catalog/page_14_img_00.webp' -%}
        {%- if forloop.index == 2 -%}
          {%- assign default_space_img = 'https://zoosh.in/images/catalog/page_21_img_00.webp' -%}
        {%- endif -%}

        <div class="group relative overflow-hidden bg-white shadow-sm border border-neutral-100 flex flex-col justify-between" {{ block.shopify_attributes }}>
          <div class="relative aspect-[16/10] overflow-hidden bg-neutral-100">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
                width="600"
                height="375"
              >
            {%- else -%}
              <img
                src="{{ default_space_img }}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
                width="600"
                height="375"
              >
            {%- endif -%}

            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-xs text-neutral-900 text-[10px] font-sans font-semibold tracking-wider uppercase px-2.5 py-1">
              {{ block.settings.room_tag | default: 'Signature Space' }}
            </div>
          </div>

          <div class="p-6 flex items-center justify-between">
            <div>
              <h3 class="font-serif text-xl text-neutral-900 font-normal mb-1">
                {{ block.settings.title }}
              </h3>
              <p class="text-xs text-neutral-500 font-sans tracking-wide">
                {{ block.settings.description }}
              </p>
            </div>
            <a
              href="{{ block.settings.link }}"
              class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-900 group-hover:bg-black group-hover:text-white group-hover:border-black transition-colors flex-shrink-0 ml-4"
              aria-label="Explore {{ block.settings.title }}"
            >
              &rarr;
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curated Spaces",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop By Room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Architectural Spaces"
    },
    {
      "type": "url",
      "id": "link",
      "label": "View All Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View All Text",
      "default": "View All Lookbooks"
    }
  ],
  "blocks": [
    {
      "type": "space",
      "name": "Room Space",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Space Image"
        },
        {
          "type": "text",
          "id": "room_tag",
          "label": "Room Tag",
          "default": "Living Room"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Space Name",
          "default": "The Monolithic Teak Lounge"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short Description",
          "default": "Handcrafted plinth sofas, sculpted teak coffee table and cane accents."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Space Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Spaces",
      "blocks": [
        {
          "type": "space",
          "settings": {
            "room_tag": "Living Room",
            "title": "The Monolithic Teak Lounge",
            "description": "Solid Teak low-slung seating and hand-planed tables."
          }
        },
        {
          "type": "space",
          "settings": {
            "room_tag": "Dining Space",
            "title": "Minimalist Dining Suite",
            "description": "Full-length 8-seater dining table with mortise-and-tenon joints."
          }
        }
      ]
    }
  ]
}
{% endschema %}
